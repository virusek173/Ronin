# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DAILY_CHANNEL_ID=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Konwersacja
CONVERSATION_CONTEXT_LIMIT=15
CONVERSATION_TIMEOUT_MS=10800000

# Opcjonalne
TZ=Europe/Warsaw
LOG_LEVEL=info

# Scheduler — domyślnie 06:00 Europe/Warsaw
# Dev: co minutę → CRON_EXPRESSION=* * * * *
CRON_EXPRESSION=0 6 * * *
