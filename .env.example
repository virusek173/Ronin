# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DAILY_CHANNEL_ID=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Conversation
CONVERSATION_CONTEXT_LIMIT=15
CONVERSATION_TIMEOUT_MS=10800000

# Scheduler — default 06:00 Europe/Warsaw
# Dev: every minute → CRON_EXPRESSION=* * * * *
CRON_EXPRESSION=0 6 * * *

# Trip
TRIP_DEPARTURE_DATE=2025-10-01

# Optional
TZ=Europe/Warsaw
LOG_LEVEL=info


